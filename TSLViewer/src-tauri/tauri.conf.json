{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TSL Viewer",
  "version": "0.1.0",
  "identifier": "com.tsl.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TSL Viewer · TMC6460 运动控制工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
